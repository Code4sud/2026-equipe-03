# ==============================================================================
# MonBilan+ — Configuration d'environnement (Exemple sans secret réel)
# Copier vers .env : cp .env.example .env
# ==============================================================================

NODE_ENV=development
PORT=3000
API_PREFIX=v1
CORS_ORIGIN=http://localhost:4200

# --- PostgreSQL (Rôle applicatif non-superuser soumis à FORCE RLS) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=monbilan_plus
# Rôle admin (uniquement pour exécuter les migrations DDL)
DATABASE_ADMIN_URL="postgresql://monbilan_owner:local_dev_owner_pwd@localhost:5432/monbilan_plus?schema=public"
# Rôle applicatif (NOBYPASSRLS — utilisé par l'API et le Worker en runtime)
DATABASE_URL="postgresql://monbilan_app:local_dev_app_pwd@localhost:5432/monbilan_plus?schema=public"

# --- Redis / BullMQ (Files de tâches asynchrones sans PII) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- Authentification & Sécurité ---
# Remplacer en production par un secret fort généré aléatoirement (>= 32 octets)
JWT_SECRET="dev-only-jwt-secret-change-in-production-32bytes-minimum"
SIGNED_URL_SECRET="dev-only-signed-url-secret-change-in-prod-32bytes"
SIGNED_URL_TTL_SECONDS=300

# --- Stockage privé des PDF et Audios ---
STORAGE_DRIVER=local
PRIVATE_STORAGE_PATH="./storage/private"
MAX_PDF_SIZE_BYTES=15728640

# --- Intelligence Artificielle Locale (Ollama / Qwen) ---
# Sur macOS Apple Silicon, Ollama tourne nativement sur l'hôte (port 11434)
# Depuis un conteneur Docker : http://host.docker.internal:11434
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_TIMEOUT_MS=60000

# --- Synthèse Vocale Locale (Piper TTS) ---
TTS_PROVIDER=piper
PIPER_BINARY_PATH="/usr/local/bin/piper"
PIPER_VOICE_MODEL="fr_FR-upmc-medium"
